@model ITServiceHelpDesk.Models.ViewModels.Tickets.TicketListViewModel
@{
    ViewData["Title"] = "Moje zgłoszenia";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Moje zgłoszenia</h1>
        <p class="page-subtitle">Zgłoszenia utworzone przez Ciebie</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>
            Nowe zgłoszenie
        </a>
    </div>
</div>

<!-- Quick Filters -->
<div class="d-flex gap-2 mb-4">
    <a asp-action="MyTickets" class="btn @(Model.Filter?.Status == null ? "btn-primary" : "btn-outline-primary")">
        Wszystkie
    </a>
    <a asp-action="MyTickets" asp-route-status="Open" class="btn @(Model.Filter?.Status?.ToString() == "Open" ? "btn-primary" : "btn-outline-primary")">
        Otwarte
    </a>
    <a asp-action="MyTickets" asp-route-status="InProgress" class="btn @(Model.Filter?.Status?.ToString() == "InProgress" ? "btn-primary" : "btn-outline-primary")">
        W realizacji
    </a>
    <a asp-action="MyTickets" asp-route-status="Resolved" class="btn @(Model.Filter?.Status?.ToString() == "Resolved" ? "btn-primary" : "btn-outline-primary")">
        Rozwiązane
    </a>
</div>

<!-- Tickets List -->
@if (Model.Tickets != null && Model.Tickets.Any())
{
    @foreach (var ticket in Model.Tickets)
    {
        <div class="ticket-card">
            <div class="ticket-card-header">
                <div>
                    <span class="ticket-number">#@ticket.TicketNumber</span>
                    <span class="badge badge-status-@ticket.Status.ToString().ToLower() ms-2">@ticket.StatusDisplay</span>
                </div>
                <span class="badge badge-priority-@ticket.Priority.ToString().ToLower()">@ticket.PriorityDisplay</span>
            </div>
            
            <h5 class="ticket-title">
                <a asp-action="Details" asp-route-id="@ticket.Id">@ticket.Title</a>
            </h5>
            
            <div class="ticket-meta">
                <span class="ticket-meta-item">
                    <i class="bi bi-folder"></i>
                    @ticket.CategoryName
                </span>
                <span class="ticket-meta-item">
                    <i class="bi bi-calendar"></i>
                    @ticket.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </span>
                @if (!string.IsNullOrEmpty(ticket.AssignedToName))
                {
                    <span class="ticket-meta-item">
                        <i class="bi bi-person"></i>
                        @ticket.AssignedToName
                    </span>
                }
                <span class="ticket-meta-item">
                    <i class="bi bi-chat"></i>
                    @ticket.CommentsCount komentarzy
                </span>
            </div>
            
            <div class="mt-3">
                <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-eye me-1"></i>
                    Zobacz szczegóły
                </a>
            </div>
        </div>
    }
    
    <!-- Pagination -->
    @if (Model.Tickets.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @if (Model.Tickets.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="MyTickets" asp-route-page="@(Model.Tickets.PageIndex - 1)">
                            <i class="bi bi-chevron-left"></i> Poprzednia
                        </a>
                    </li>
                }
                @for (int i = 1; i <= Model.Tickets.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Tickets.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="MyTickets" asp-route-page="@i">@i</a>
                    </li>
                }
                @if (Model.Tickets.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="MyTickets" asp-route-page="@(Model.Tickets.PageIndex + 1)">
                            Następna <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 64px;"></i>
            <h5 class="mt-3">Brak zgłoszeń</h5>
            <p class="text-muted">Nie masz jeszcze żadnych zgłoszeń.</p>
            <a asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-lg me-2"></i>Utwórz pierwsze zgłoszenie
            </a>
        </div>
    </div>
}
